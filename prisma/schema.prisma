generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models are added incrementally per the build blueprint (B1: User/auth,
// B2: Category, B3: Event — current). Registration/Report/ReminderConfig
// arrive in B4, at which point their relation fields are added back onto
// Event and User.

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String? // null if OAuth-only
  name         String
  role         Role         @default(USER)
  authProvider AuthProvider @default(LOCAL)
  providerId   String?
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens RefreshToken[]
  events        Event[]        @relation("OrganizerEvents")
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  events Event[]
}
