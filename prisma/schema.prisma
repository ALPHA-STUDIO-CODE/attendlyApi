generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase B (data model) is now complete: User/auth (B1), Category (B2),
// Event (B3), Registration/Report/ReminderConfig (B4 — current). Matches
// spec §4 in full. Auth endpoints and business logic build on this
// starting in Phase C.

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String? // null if OAuth-only
  name         String
  role         Role         @default(USER)
  authProvider AuthProvider @default(LOCAL)
  providerId   String?
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens RefreshToken[]
  events        Event[]        @relation("OrganizerEvents")
  registrations Registration[]
  reports       Report[]
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime? // set on rotation (old token) or reuse-triggered mass revocation.
  // Logout, by contrast, hard-deletes the row (see C4) rather than setting
  // this — there's no reuse-detection value in keeping a logged-out token
  // around, unlike a rotated one.

  @@index([userId, revokedAt])
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  events Event[]
}

model Event {
  id             String      @id @default(uuid())
  organizerId    String
  organizer      User        @relation("OrganizerEvents", fields: [organizerId], references: [id])
  title          String
  description    String
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  customTags     String[]
  bannerImageUrl String?
  venueName      String
  address        String
  city           String
  timezone       String // IANA tz, e.g. "America/New_York"
  date           DateTime // stored UTC
  startTime      DateTime
  endTime        DateTime
  maxCapacity    Int
  status         EventStatus @default(PUBLISHED)
  isLocked       Boolean     @default(false)
  deletedAt      DateTime? // admin soft-delete (Phase L), distinct from organizer CANCELLED status
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  registrations   Registration[]
  reports         Report[]
  reminderConfigs ReminderConfig[]

  @@index([city])
  @@index([categoryId])
  @@index([date])
}

enum EventStatus {
  PUBLISHED
  CANCELLED
  FLAGGED
}

model Registration {
  id               String             @id @default(uuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id])
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  status           RegistrationStatus @default(REGISTERED)
  ticketToken      String             @unique // signed token encoded in QR
  checkedInAt      DateTime?
  waitlistPosition Int?
  createdAt        DateTime           @default(now())

  @@unique([eventId, userId]) // prevents duplicate registration
  @@index([eventId, status])
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

// checked-in tracked via checkedInAt being non-null, keeps status simpler

model Report {
  id         String       @id @default(uuid())
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model ReminderConfig {
  id          String  @id @default(uuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id])
  hoursBefore Int
  sent        Boolean @default(false)
}
