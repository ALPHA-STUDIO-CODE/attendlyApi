# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# Main application database (used by `npm run dev`, `prisma migrate dev`, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendly_dev"

# Separate database used only by the automated test suite. Its schema is
# reset before each test run (see `npm run test:db:reset`) so it must never
# point at the same database as DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendly_test"

PORT=3000

# Secret used to sign/verify short-lived access tokens (see src/auth/jwt.ts).
# Kept deliberately separate from the ticket-token secret added later
# (Phase J), so a leak of one doesn't compromise the other. Use a long,
# random value in real environments — e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
