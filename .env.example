# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# Main application database (used by `npm run dev`, `prisma migrate dev`, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendly_dev"

# Separate database used only by the automated test suite. Its schema is
# reset before each test run (see `npm run test:db:reset`) so it must never
# point at the same database as DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendly_test"

PORT=3000

# Secret used to sign/verify short-lived access tokens (see src/auth/jwt.ts).
# Kept deliberately separate from the ticket-token secret added later
# (Phase J), so a leak of one doesn't compromise the other. Use a long,
# random value in real environments — e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"

# Google OAuth (see https://console.cloud.google.com/apis/credentials).
# Only needed to actually exercise POST /api/auth/oauth/google against
# real Google servers — the test suite mocks src/auth/oauth/google.ts
# entirely and never calls out to Google (see spec §12: never hit real
# third-party APIs in CI).
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"

# GitHub OAuth (see https://github.com/settings/developers). Requires the
# 'user:email' scope so exchangeGitHubAuthCode can fall back to fetching
# a verified email if the user's primary email is set private. Only
# needed to exercise POST /api/auth/oauth/github against real GitHub
# servers — the test suite mocks src/auth/oauth/github.ts entirely.
GITHUB_CLIENT_ID="replace-with-your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-your-github-oauth-client-secret"
GITHUB_REDIRECT_URI="http://localhost:5173/auth/github/callback"

# Cloudinary (https://console.cloudinary.com/settings/api-keys) — event banner
# uploads (POST /api/events/:id/banner, see src/integrations/cloudinary.ts).
# Only needed to upload real banners; the test suite mocks the Cloudinary
# wrapper entirely and never calls out to Cloudinary. If unset, banner
# uploads fail with 502 UPLOAD_FAILED — everything else keeps working.
CLOUDINARY_CLOUD_NAME="replace-with-your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-your-cloudinary-api-secret"
